theme = TokyoNight
palette-generate = true

font-family = Consolas
font-size = 14
font-thicken = true

scrollback-limit = 10000

background-opacity = 1
background-blur = false
window-padding-balance = true
macos-titlebar-style = hidden
macos-titlebar-proxy-icon = hidden
macos-non-native-fullscreen = true
macos-window-buttons = hidden

copy-on-select = clipboard
right-click-action = paste

keybind = ctrl+shift+r=reload_config

# コマンドパレットの既定項目に無い操作を追加する
command-palette-entry = title:"Toggle Quick Terminal",action:"toggle_quick_terminal"
command-palette-entry = title:"Jump to Previous Prompt",action:"jump_to_prompt:-1"
command-palette-entry = title:"Jump to Next Prompt",action:"jump_to_prompt:1"
