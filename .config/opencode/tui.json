{
  "$schema": "https://opencode.ai/tui.json",
  "theme": "tokyonight",
  "attention": {
    "enabled": true,
    "notifications": true,
    "sound": false,
    "volume": 0.4
  },
  "keybinds": {
    "input_submit": "ctrl+return,super+return",
    "input_newline": "return,shift+return,alt+return",
    "input_backspace": "backspace,shift+backspace,ctrl+h",
    "input_delete_to_line_end": "ctrl+k"
  }
}