# .tigrc - tig configuration file (v2.6+)
# Modern configuration with improved cursor visibility

#######################################
# General Settings
#######################################

set mouse = yes
set refresh-mode = auto
set tab-size = 4
set diff-context = 3
set ignore-space = some
set commit-order = topo
set ignore-case = smart-case
set wrap-lines = no
set focus-child = yes
set vertical-split = no
set split-view-height = 70%
set horizontal-scroll = 33%
set status-show-untracked-dirs = yes
set git-colors = no
set blame-options = -C -C -C


#######################################
# View Settings (Modern Syntax)
#######################################

# Main view
set main-view = \
    line-number:yes,interval=5 \
    id:yes \
    date:relative \
    author:full \
    commit-title:yes,graph,refs,overflow=no

# Blame view
set blame-view = \
    line-number:yes,interval=5 \
    id:yes \
    date:relative \
    author:full \
    text

# Tree view
set tree-view = \
    line-number:yes,interval=5 \
    mode \
    author:full \
    date:relative \
    file-size:units \
    id:yes \
    file-name

# Blob view
set blob-view = \
    line-number:yes,interval=5 \
    text

# Diff view
set diff-view = \
    line-number:yes,interval=5 \
    text:yes,commit-title-overflow=no

# Log view
set log-view = \
    line-number:yes,interval=5 \
    text

# Refs view
set refs-view = \
    line-number:yes,interval=5 \
    id:yes \
    date:relative \
    author:full \
    ref \
    commit-title

# Stash view
set stash-view = \
    line-number:yes,interval=5 \
    id:yes \
    date:relative \
    author:full \
    commit-title

# Status view
set status-view = \
    line-number:yes,interval=5 \
    status:long \
    file-name

# Stage view
set stage-view = \
    line-number:yes,interval=5 \
    text


#######################################
# Key Bindings
#######################################

# Reload .tigrc
bind generic S :source ~/.tigrc

# Copy commit hash to clipboard
bind generic Y @sh -c "printf '%(commit)' | pbcopy"

# Interactive rebase
bind main R !git rebase -i %(commit)~

# Cherry-pick
bind main C !git cherry-pick %(commit)

# Amend last commit
bind status A !git commit --amend

# Fetch and pull
bind generic F !git fetch --all --prune
bind generic P !git pull --rebase

# Stage/unstage single line
bind stage 1 stage-update-line


#######################################
# Color Settings - High Contrast
#######################################
# Tokyo Night, muted. tig 2.6 takes no #rrggbb, so colors are xterm-256 indexes.
# Each hue is one step down in saturation from the stock Tokyo Night value, and
# the background is left to the terminal so wezterm's opacity still applies.
#   fg 146  comment/dim 60  blue 110  cyan 109  green 108  magenta 140
#   red 174  orange 173  yellow 180  cursor bg 60

# General UI
color default           color146 default
color cursor            color189 color60   bold
color cursor-blur       color146 color236
color title-focus       color189 color60   bold
color title-blur        color60  color236
color search-result     color0   color180
color status            color109 default
color header            color140 default

# Line numbers and delimiters
color line-number       color60  default
color delimiter         color60  default
color id                color140 default

# Dates and authors
color date              color109 default
color author            color108 default
color committer         color60  default

# Diff colors
color diff-header       color180 default
color diff-index        color110 default
color diff-chunk        color109 default
color diff-add          color108 default
color diff-del          color174 default
color diff-oldmode      color180 default
color diff-newmode      color180 default

# Commit information
color "Author: "        color108 default
color "Commit: "        color109 default
color "Date: "          color180 default
color "Merge: "         color110 default
color "Reported-by: "   color108 default
color "Signed-off-by: " color180 default
color "Co-authored-by: " color180 default

# Graph and references
color graph-commit      color110 default
color main-head         color174 default  bold
color main-tag          color180 default
color main-local-tag    color180 default
color main-remote       color108 default
color main-tracked      color109 default
color main-ref          color140 default

# Tree view
color tree.header       color180 default
color tree.directory    color110 default
color tree.file         color146 default

# Status view
color stat-staged       color108 default
color stat-unstaged     color174 default
color stat-untracked    color173 default

# Help view
color help-group        color140 default
color help-action       color180 default
